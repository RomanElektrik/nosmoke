{
  "expo": {
    "name": "Бриз",
    "slug": "quit-smoke",
    "version": "1.0.6",
    "orientation": "portrait",
    "scheme": "quitsmoke",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.quitsmoke.client",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.quitsmoke.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A1D15"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-notifications",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Бриз использует фото только чтобы поставить картинку на твою цель или причину — они хранятся на устройстве."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8190bbe8-96cc-4a73-a2d3-4a42bc159e1c"
      }
    },
    "owner": "romansuuz"
  }
}
